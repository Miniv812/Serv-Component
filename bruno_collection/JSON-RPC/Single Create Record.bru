meta {
  name: Single Create Record
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/rpc
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "create_record",
    "params": {
      "user_id": 1,
      "category_id": 1,
      "amount": 50.0
    },
    "id": 1
  }
}
